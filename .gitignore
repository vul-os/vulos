# ── Environment files ─────────────────────────────────────────────────────────
# .env is tracked on purpose: it holds non-secret local-dev defaults and is read
# by internal/config for --env=local. Every other env file may hold real
# credentials and must never be committed.
.env.local
.env.*.local
.env.main
.env.dev

# ── Signing keys ──────────────────────────────────────────────────────────────
# NEVER commit a private key. The public halves (keys/trust-anchor.pub,
# keys/release-cert.json, keys/*.pub.json) ARE committed — they are what the
# image ships and what CI verifies against. See docs/KEY-CEREMONY.md.
keys/*.priv.json
keys/*.key
keys/*.pem

# Compiled dev server binary (see backend/vulos-server above)
backend/vulos
