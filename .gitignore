# ---- Go ----
bin/
dist/
# Exception: web/dist is the BUILT management console SPA, compiled into the
# binary via //go:embed in web/embed.go. It MUST be committed so `go build ./...`
# is green without a Node toolchain. Rebuild with `make console`.
!/web/dist/
*.exe
*.test
*.out
*.prof
vendor/
# Compiled control-plane binaries (root-anchored so they never match the
# cmd/server source directory or any nested package named the same).
/cp
/server
/migrate
/idp
/cloudlet

# ---- Databases / local state ----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/
# Exception: pkg/security/data holds legit_ja3.txt, a REQUIRED `//go:embed
# data/legit_ja3.txt` asset in pkg/security/bot.go. Without it the module fails
# to build for any external consumer (e.g. vulos-cloud): "pattern
# data/legit_ja3.txt: no matching files found". It must be committed.
!/pkg/security/data/
/secrets/

# ---- Node / frontend ----
node_modules/
build/
coverage/
.vite/
*.tsbuildinfo

# ---- Playwright / test output ----
test-results/
playwright-report/
/blob-report/
/.playwright/

# ---- Env / secrets ----
.env
.env.*
!.env.example
!.env.sample
!.env.template

# ---- Editor / OS ----
.DS_Store
.idea/
.vscode/
*.swp
tmp/
.claude

# screenshotter tooling deps (the dir, and the dev symlink of the same name)
scripts/screenshots/node_modules/
scripts/screenshots/node_modules
