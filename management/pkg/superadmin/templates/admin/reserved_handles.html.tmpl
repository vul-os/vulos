{{define "reserved_handles"}}
<div class="page-head">
  <h1>Reserved handles</h1>
  <p class="page-sub">The reserved-username registry — RFC&nbsp;2142 mailboxes, platform and brand handles that cannot be claimed by members.</p>
</div>
{{if .Flash}}<div class="flash-ok">{{.Flash}}</div>{{end}}
{{if .FlashErr}}<div class="flash-err">{{.FlashErr}}</div>{{end}}
<form method="POST" action="/superadmin/reserved-handles" class="filter-bar">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <input type="text" name="handle" placeholder="handle" required>
  <input type="text" name="reason" placeholder="reason" required>
  <button type="submit" class="primary">Reserve</button>
</form>
<div class="table-wrap">
<table>
<thead><tr><th>Handle</th><th>Reason</th><th>Added By</th><th>Added At</th><th>Action</th></tr></thead>
<tbody>
{{range .Handles}}
<tr>
  <td>{{.Handle}}</td>
  <td>{{.Reason}}</td>
  <td>{{if .ReadOnly}}<span class="ro">system</span>{{else}}{{.AddedBy}}{{end}}</td>
  <td>{{.AddedAt}}</td>
  <td>
    {{if .ReadOnly}}
    <span class="pill neutral">read-only</span>
    {{else}}
    <a class="btn danger" href="/superadmin/reserved-handles/confirm-delete?handle={{.Handle}}">Delete</a>
    {{end}}
  </td>
</tr>
{{end}}
</tbody>
</table>
</div>
{{end}}
