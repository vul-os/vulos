{{define "auditlog"}}
<div class="page-head">
  <h1>Audit log</h1>
  <p class="page-sub">The tamper-evident, hash-chained record of every operator action. Filter by actor, action or time window. Verify the chain from Maintenance.</p>
</div>
<form method="GET" action="/superadmin/auditlog" class="filter-bar">
  <input type="text" name="actor" value="{{.Actor}}" placeholder="actor">
  <input type="text" name="action" value="{{.Action}}" placeholder="action">
  <input type="text" name="from" value="{{.From}}" placeholder="from (RFC3339)">
  <input type="text" name="to" value="{{.To}}" placeholder="to (RFC3339)">
  <button type="submit" class="primary">Filter</button>
</form>
{{if .Rows}}
<div class="table-wrap">
<table>
<thead><tr><th class="right">Seq</th><th>Time</th><th>Actor</th><th>Action</th><th>Target</th><th class="wrap">Metadata</th></tr></thead>
<tbody>
{{range .Rows}}
<tr>
  <td class="num-cell">{{.Seq}}</td>
  <td class="mono muted">{{.Ts}}</td>
  <td>{{.Actor}}</td>
  <td class="mono">{{.Action}}</td>
  <td class="mono">{{.Target}}</td>
  <td class="wrap mono muted">{{.MetadataJSON}}</td>
</tr>
{{end}}
</tbody>
</table>
</div>
{{else}}
<div class="empty">
  <span class="empty-t">No matching audit entries</span>
  <span class="empty-d">Adjust the actor, action or time-window filters, or clear them to see the full chain.</span>
</div>
{{end}}
{{end}}
