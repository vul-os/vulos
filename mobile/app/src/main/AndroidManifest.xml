<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Embedded telephony (mobile/DECISIONS.md TEL-01, revising MOB-07). All are
         RUNTIME-requested on first use, never at install. READ_SMS / RECEIVE_SMS /
         READ_CALL_LOG are Play "restricted" permissions (need a Permissions
         Declaration + default-handler justification); the sovereign / F-Droid APK
         is unaffected. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Native capabilities added in CONTACTS/CAM/NOTIFY/BIO/FILES/LAUNCH-01. All
         dangerous permissions are RUNTIME-requested CONTEXTUALLY on first use (see
         BridgeBase.withPerm), never at install; every feature degrades gracefully to
         the PWA path when denied. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ notification permission (auto-granted below 13). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground service that keeps the box connection alive (user-toggled only). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Camera is optional hardware: a device without one still installs and uses the
         rest of the app (photo/video/QR just report unavailable). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".VulosApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Vulos">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Launcher role ENABLED (TEL-01/LAUNCH-01, revising MOB-05). Vulos
                 becomes a SELECTABLE home app; it is NEVER made default here — the
                 user opts in through vulosLauncher (LauncherBridge), which only opens
                 the system chooser, and can revert at any time. Safe because: the
                 home surface paints from the locally-bundled shell (no network on
                 cold start), the WebView is pre-warmed in VulosApplication.onCreate(),
                 and windowBackground is a dark shell-colored drawable (no white flash). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Share target (FILES-01): receive text and files shared from other
                 apps. MainActivity forwards them to the files bridge, which buffers
                 until the shell subscribes. singleTask + onNewIntent handle the
                 already-running case. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- Foreground service (NOTIFY-01). type=dataSync: keeps the box connection
             alive for reliable notifications. Started/stopped ONLY by the user via
             the notify bridge — never auto-started. Not exported. -->
        <service
            android:name=".BoxConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider for camera capture + share-out (grants scoped, temporary
             read/write on cache/* files only; see res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Incoming SMS. android:permission="BROADCAST_SMS" means ONLY the system
             (which holds that signature permission) can deliver here — no other app
             can forge an inbound SMS. Requires RECEIVE_SMS at runtime to actually
             receive. This is a NON-default-handler receiver (SMS_RECEIVED, not
             SMS_DELIVER): we observe + read + send, without taking the full
             default-SMS-app contract. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
