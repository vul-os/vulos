          "archive_strip": 0,
          "command": "bin/navidrome --configfile data/navidrome.toml",
          "port": 4533,
          "post_install": "mkdir -p data/music && printf 'MusicFolder = \"%s/data/music\"\\nDataFolder = \"%s/data\"\\nPort = %s\\nAddress = \"0.0.0.0\"\\n' \"$APP_DIR\" \"$APP_DIR\" \"${PORT}\" > data/navidrome.toml",
          "checksum": "",
          "permissions": [
            "network",
            "filesystem"
          ],
          "singleton": true
        }
      }
    },
