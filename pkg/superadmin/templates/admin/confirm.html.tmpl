{{define "confirm"}}
<div class="card wide">
<h1>{{.Heading}}</h1>
<div class="confirm-detail">
  {{range .Lines}}<p>{{.}}</p>{{end}}
</div>
{{if .Warn}}<div class="banner warn">{{.Warn}}</div>{{end}}
<form method="POST" action="{{.ActionURL}}">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  {{range .Hidden}}<input type="hidden" name="{{.Name}}" value="{{.Value}}">{{end}}
  {{if .RequireTOTP}}
  <div class="form-row">
    <label for="totp">Re-enter your TOTP code to confirm</label>
    <input id="totp" type="text" name="totp" required maxlength="8" inputmode="numeric" autocomplete="one-time-code" autofocus>
  </div>
  {{end}}
  <div class="confirm-actions">
    <a class="btn ghost" href="{{.CancelURL}}">Cancel</a>
    <button type="submit" class="{{if .Danger}}danger{{else}}primary{{end}}">{{.ConfirmLabel}}</button>
  </div>
</form>
</div>
{{end}}
