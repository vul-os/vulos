{{define "layout"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<title>{{.Title}} — Vulos Operator Console</title>
<link rel="stylesheet" href="/superadmin/admin.css">
</head>
<body>
<header class="topbar">
  <a class="tb-brand" href="/superadmin/">
    <span class="tb-mark">V</span>
    <span class="tb-word">Vulos</span>
    <span class="tb-tag">Operator</span>
  </a>
  <nav class="tb-nav" aria-label="Primary">
    <span class="tb-group">
      <a href="/superadmin/"          class="{{if eq .Section "home"}}active{{end}}"{{if eq .Section "home"}} aria-current="page"{{end}}>Overview</a>
      <a href="/superadmin/analytics" class="{{if eq .Section "analytics"}}active{{end}}"{{if eq .Section "analytics"}} aria-current="page"{{end}}>Analytics</a>
    </span>
    <span class="tb-group">
      <a href="/superadmin/accounts"         class="{{if eq .Section "accounts"}}active{{end}}"{{if eq .Section "accounts"}} aria-current="page"{{end}}>Accounts</a>
      <a href="/superadmin/orgs"             class="{{if eq .Section "orgs"}}active{{end}}"{{if eq .Section "orgs"}} aria-current="page"{{end}}>Orgs</a>
      <a href="/superadmin/reserved-handles" class="{{if eq .Section "handles"}}active{{end}}"{{if eq .Section "handles"}} aria-current="page"{{end}}>Handles</a>
    </span>
    <span class="tb-group">
      <a href="/superadmin/relay"      class="{{if eq .Section "relay"}}active{{end}}"{{if eq .Section "relay"}} aria-current="page"{{end}}>Relay</a>
      <a href="/superadmin/incidents"  class="{{if eq .Section "incidents"}}active{{end}}"{{if eq .Section "incidents"}} aria-current="page"{{end}}>Incidents</a>
      <a href="/superadmin/migrations" class="{{if eq .Section "migrations"}}active{{end}}"{{if eq .Section "migrations"}} aria-current="page"{{end}}>Migrations</a>
    </span>
    <span class="tb-group">
      <a href="/superadmin/auditlog"    class="{{if eq .Section "audit"}}active{{end}}"{{if eq .Section "audit"}} aria-current="page"{{end}}>Audit Log</a>
      <a href="/superadmin/maintenance" class="{{if eq .Section "maintenance"}}active{{end}}"{{if eq .Section "maintenance"}} aria-current="page"{{end}}>Maintenance</a>
    </span>
  </nav>
  <div class="tb-right">
    <span class="tb-op"><span class="dot"></span>operator</span>
    <a class="tb-logout" href="/superadmin/logout">Log out</a>
  </div>
</header>
<main>
{{.Body}}
</main>
</body>
</html>
{{end}}
