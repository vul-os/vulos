{{define "accounts"}}
<div class="page-head">
  <h1>Accounts</h1>
  <p class="page-sub">Search member accounts and act on them — suspend, force a password reset or reset 2FA. Every action is written to the hash-chained audit log.</p>
</div>
{{if .Flash}}<div class="flash-ok">{{.Flash}}</div>{{end}}
{{if .FlashErr}}<div class="flash-err">{{.FlashErr}}</div>{{end}}
<form method="GET" action="/superadmin/accounts" class="filter-bar">
  <input type="search" name="q" value="{{.Q}}" placeholder="search email / handle / ID">
  <button type="submit" class="primary">Search</button>
</form>
{{if .Accounts}}
<div class="table-wrap">
<table>
<thead><tr>
  <th>ID</th><th>Email</th><th>Status</th><th>Fleet Admin</th><th>Created</th><th>Actions</th>
</tr></thead>
<tbody>
{{range .Accounts}}
<tr>
  <td class="mono"><a href="/superadmin/accounts/{{.ID}}">{{.ID}}</a></td>
  <td>{{.Email}}</td>
  <td>{{if .Suspended}}<span class="pill suspended">suspended</span>{{else}}<span class="pill active">active</span>{{end}}</td>
  <td>{{if .FleetAdmin}}<span class="pill brand">fleet</span>{{else}}<span class="muted">—</span>{{end}}</td>
  <td class="mono muted">{{.CreatedAt}}</td>
  <td>
    <span class="actions">
    {{if .Suspended}}
    <form method="POST" action="/superadmin/accounts/{{.ID}}/action">
      <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
      <input type="hidden" name="action" value="unsuspend">
      <button type="submit" class="sm">Unsuspend</button>
    </form>
    {{else}}
    <a class="btn danger sm" href="/superadmin/accounts/{{.ID}}/confirm?action=suspend">Suspend</a>
    {{end}}
    <a class="btn sm" href="/superadmin/accounts/{{.ID}}/confirm?action=force-password-reset">Force Reset</a>
    <a class="btn danger sm" href="/superadmin/accounts/{{.ID}}/confirm?action=2fa-reset">Reset 2FA</a>
    </span>
  </td>
</tr>
{{end}}
</tbody>
</table>
</div>
<div class="pager">
  {{if gt .Offset 0}}<a href="?q={{.Q}}&offset={{.PrevOffset}}&limit={{.Limit}}">&larr; Prev</a>{{end}}
  {{if .HasMore}}<a href="?q={{.Q}}&offset={{.NextOffset}}&limit={{.Limit}}">Next &rarr;</a>{{end}}
</div>
{{else}}
<div class="empty">
  <span class="empty-t">No accounts match</span>
  <span class="empty-d">{{if .Q}}Nothing found for “{{.Q}}”. Try an email, handle or account ID.{{else}}Search by email, handle or account ID to find and act on a member account.{{end}}</span>
</div>
{{end}}
{{end}}
