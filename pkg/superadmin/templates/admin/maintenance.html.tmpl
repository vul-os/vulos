{{define "maintenance"}}
<div class="page-head">
  <h1>Maintenance</h1>
  <p class="page-sub">Operator tooling — verify the integrity of the audit-log hash chain, review secret rotation and inspect the sub-processor changelog.</p>
</div>
{{if .Flash}}<div class="flash-ok">{{.Flash}}</div>{{end}}
{{if .Error}}<div class="flash-err">{{.Error}}</div>{{end}}

<h2>Audit Log</h2>
<form method="POST" action="/superadmin/maintenance/verify-auditlog">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <button type="submit" class="primary">Verify Audit-Log Chain</button>
</form>
{{if .AuditVerifyResult}}<p>Chain verify result: <b>{{.AuditVerifyResult}}</b></p>{{end}}

<h2>Secrets</h2>
<form method="POST" action="/superadmin/maintenance/rotation-check">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <button type="submit">Run Secret Rotation Check</button>
</form>
{{if .RotationResult}}<pre>{{.RotationResult}}</pre>{{end}}

<h2>Sub-processors</h2>
<form method="POST" action="/superadmin/maintenance/subprocessor-changelog">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <button type="submit">List Sub-processor Changelog</button>
</form>
{{if .SubProcessorLog}}<pre>{{.SubProcessorLog}}</pre>{{end}}
{{end}}
