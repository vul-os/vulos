{{define "incidents"}}
<div class="page-head">
  <h1>System health &amp; incidents</h1>
  <p class="page-sub">Author the incidents and maintenance windows shown on the public status page. Every change here is audit-logged.</p>
</div>
{{if not .Available}}
<div class="note"><strong>Status store not wired.</strong> This control plane has no
durable status store, so incidents cannot be authored here.</div>
{{else}}
{{if .Flash}}<div class="flash-ok">{{.Flash}}</div>{{end}}
{{if .FlashErr}}<div class="flash-err">{{.FlashErr}}</div>{{end}}

<p class="note">
  Incidents and maintenance authored here are read by the public status page
  (<code>/api/status/incidents</code>). Every action is audit-logged.
</p>

<h2>Open incidents</h2>
<div class="table-wrap">
<table>
<thead><tr><th>Title</th><th>Severity</th><th>Started</th><th>State</th><th>Updates</th></tr></thead>
<tbody>
{{range .Incidents}}
<tr>
  <td>{{.Title}}<br><span class="ro">{{.ID}}</span></td>
  <td>{{.Severity}}</td>
  <td>{{.StartedAt}}</td>
  <td>{{if .Resolved}}<span class="pill active">resolved {{.ResolvedAt}}</span>{{else}}<span class="pill warn">open</span>{{end}}</td>
  <td>
    {{range .Updates}}<div class="ro">{{.PostedAt}} — {{.Status}}: {{.Body}}</div>{{else}}<span class="ro">—</span>{{end}}
  </td>
</tr>
{{else}}
<tr><td colspan="5" class="empty">No incidents.</td></tr>
{{end}}
</tbody>
</table>
</div>

<h2>Open an incident</h2>
<form method="POST" action="/superadmin/incidents/create" class="stack-form">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <label>Title <input type="text" name="title" required></label>
  <label>Body <textarea name="body" rows="3"></textarea></label>
  <label>Severity
    <select name="severity">
      <option value="minor">minor</option>
      <option value="major">major</option>
      <option value="critical">critical</option>
      <option value="maintenance">maintenance</option>
    </select>
  </label>
  <label>Components (comma-separated) <input type="text" name="components" placeholder="relay-eu, control-plane"></label>
  <button type="submit" class="primary">Open incident</button>
</form>

<h2>Post an update / resolve</h2>
<form method="POST" action="/superadmin/incidents/update" class="stack-form">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <label>Incident id <input type="text" name="incident_id" required></label>
  <label>Status <input type="text" name="status" placeholder="investigating"></label>
  <label>Update text <textarea name="body" rows="2" required></textarea></label>
  <button type="submit" class="primary">Post update</button>
</form>
<form method="POST" action="/superadmin/incidents/resolve" class="inline-form">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <label>Resolve incident id <input type="text" name="incident_id" required></label>
  <button type="submit" class="btn">Resolve</button>
</form>

<h2>Scheduled maintenance</h2>
<div class="table-wrap">
<table>
<thead><tr><th>Title</th><th>Window</th><th>Components</th></tr></thead>
<tbody>
{{range .Maintenance}}
<tr>
  <td>{{.Title}}<br><span class="ro">{{.ID}}</span></td>
  <td>{{.StartsAt}} → {{.EndsAt}}</td>
  <td>{{range .Components}}<code>{{.}}</code> {{else}}<span class="ro">—</span>{{end}}</td>
</tr>
{{else}}
<tr><td colspan="3" class="empty">No maintenance scheduled.</td></tr>
{{end}}
</tbody>
</table>
</div>

<h2>Schedule maintenance</h2>
<form method="POST" action="/superadmin/incidents/maintenance" class="stack-form">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <label>Title <input type="text" name="title" required></label>
  <label>Body <textarea name="body" rows="2"></textarea></label>
  <label>Components (comma-separated) <input type="text" name="components"></label>
  <label>Starts at (RFC3339) <input type="text" name="starts_at" placeholder="2026-07-20T02:00:00Z" required></label>
  <label>Ends at (RFC3339) <input type="text" name="ends_at" placeholder="2026-07-20T04:00:00Z" required></label>
  <button type="submit" class="primary">Schedule</button>
</form>
{{end}}
{{end}}
