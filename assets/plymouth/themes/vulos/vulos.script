/*
 * Vula OS Plymouth boot splash — vulos.script
 *
 * Features:
 *   - Dark background (#111111)
 *   - Centred Vula OS logo (logo.png, ~128px)
 *   - Determinate progress bar with percentage label
 *     driven by real boot milestones (0–100%)
 *   - Ctrl+V verbose toggle: hides splash, reveals TTY journal output
 *   - Graceful fade-out before labwc/desktop appears
 *
 * Kernel cmdline: quiet splash plymouth.theme=vulos
 *
 * Progress milestones (via `plymouth system-update --progress=N`
 *   or `plymouth update --status="NN:phase name"`):
 *
 *    0%   Kernel loaded, initramfs running
 *   10%   Filesystems mounted
 *   20%   systemd started
 *   30%   Networking up (DHCP acquired)
 *   45%   PipeWire started
 *   55%   labwc compositor started
 *   65%   vulos-server started (HTTP 200 on /health)
 *   80%   Browser launched, loading React app
 *   95%   Desktop shell rendered
 *  100%   Plymouth fades out → desktop visible
 */

/* ── Colours ──────────────────────────────────────────────────── */
bg_r = 0.067;  bg_g = 0.067;  bg_b = 0.067;   /* #111111 */
fg_r = 0.788;  fg_g = 0.416;  fg_b = 1.000;   /* #C96AFF — Vula purple */
tk_r = 0.141;  tk_g = 0.141;  tk_b = 0.141;   /* #242424 — bar track   */
tx_r = 0.600;  tx_g = 0.600;  tx_b = 0.600;   /* #999999 — status text */
hn_r = 0.400;  hn_g = 0.400;  hn_b = 0.400;   /* #666666 — hint text   */

/* ── Screen geometry ─────────────────────────────────────────── */
sw = Window.GetWidth();
sh = Window.GetHeight();
cx = sw / 2;
cy = sh / 2;

/* ── Solid dark background ───────────────────────────────────── */
/*
 * Try loading the PNG first; fall back to a Window colour fill
 * so the theme works even if background.png is missing.
 */
bg_image = Image("background.png");
if (bg_image) {
    bg_sprite = Sprite(bg_image.Scale(sw, sh));
    bg_sprite.SetX(0);
    bg_sprite.SetY(0);
    bg_sprite.SetZ(-100);
} else {
    Window.SetBackgroundTopColor(bg_r, bg_g, bg_b);
    Window.SetBackgroundBottomColor(bg_r, bg_g, bg_b);
    bg_sprite = NULL;
}

/* ── Logo ────────────────────────────────────────────────────── */
logo_image = Image("logo.png");
logo_sprite = NULL;
logo_w = 0;
logo_h = 0;
if (logo_image) {
    logo_w = logo_image.GetWidth();
    logo_h = logo_image.GetHeight();
    logo_sprite = Sprite(logo_image);
    logo_sprite.SetX(cx - logo_w / 2);
    logo_sprite.SetY(cy - logo_h / 2 - 60);
    logo_sprite.SetZ(10);
}

/* ── Progress bar geometry ───────────────────────────────────── */
bar_w = Math.Min(400, Math.Round(sw * 0.5));
bar_h = 6;
bar_r = bar_h / 2;                    /* rounded cap radius */
bar_x = cx - bar_w / 2;
bar_y = cy + 80;

/* Track (the dark backing strip) */
bar_track_image = Image.CreateFilledRoundedRectangle(
    bar_w, bar_h, bar_r, tk_r, tk_g, tk_b, 1.0);
bar_track_sprite = Sprite(bar_track_image);
bar_track_sprite.SetX(bar_x);
bar_track_sprite.SetY(bar_y);
bar_track_sprite.SetZ(20);

/* Fill — rebuilt on every progress update; starts at 0-width */
bar_fill_sprite = NULL;

/* ── Percentage label ────────────────────────────────────────── */
pct_sprite = NULL;

/* ── Keyboard hint ───────────────────────────────────────────── */
hint_image = Image.Text("Ctrl+V for verbose output",
    hn_r, hn_g, hn_b, 1.0);
hint_sprite = NULL;
if (hint_image) {
    hint_sprite = Sprite(hint_image);
    hint_sprite.SetX(cx - hint_image.GetWidth() / 2);
    hint_sprite.SetY(sh - 48);
    hint_sprite.SetZ(20);
}

/* ── State ───────────────────────────────────────────────────── */
boot_progress = 0;
verbose_mode  = 0;

/* ── Helper: render fill bar + percentage label ──────────────── */
fun DrawProgress(pct) {
    if (pct < 0)   pct = 0;
    if (pct > 100) pct = 100;

    /* Minimum visible width = bar height (keeps bar visible at 0%) */
    fill_w = Math.Max(bar_h, Math.Round(bar_w * pct / 100));

    fill_image = Image.CreateFilledRoundedRectangle(
        fill_w, bar_h, bar_r, fg_r, fg_g, fg_b, 1.0);

    if (bar_fill_sprite) {
        bar_fill_sprite.SetImage(fill_image);
    } else {
        bar_fill_sprite = Sprite(fill_image);
        bar_fill_sprite.SetX(bar_x);
        bar_fill_sprite.SetY(bar_y);
        bar_fill_sprite.SetZ(25);
    }

    /* Percentage label, e.g. "67%" */
    pct_str   = Math.Int(pct) + "%";
    pct_image = Image.Text(pct_str, tx_r, tx_g, tx_b, 1.0);
    if (pct_image) {
        if (pct_sprite) {
            pct_sprite.SetImage(pct_image);
        } else {
            pct_sprite = Sprite(pct_image);
            pct_sprite.SetZ(20);
        }
        pct_sprite.SetX(cx - pct_image.GetWidth() / 2);
        pct_sprite.SetY(bar_y + bar_h + 10);
    }
}

/* ── Helper: show all splash sprites ────────────────────────── */
fun ShowSplash() {
    if (bg_sprite)       bg_sprite.SetOpacity(1.0);
    if (logo_sprite)     logo_sprite.SetOpacity(1.0);
    bar_track_sprite.SetOpacity(1.0);
    if (bar_fill_sprite) bar_fill_sprite.SetOpacity(1.0);
    if (pct_sprite)      pct_sprite.SetOpacity(1.0);
    if (hint_sprite)     hint_sprite.SetOpacity(1.0);
}

/* ── Helper: hide all splash sprites (verbose mode) ─────────── */
fun HideSplash() {
    if (bg_sprite)       bg_sprite.SetOpacity(0.0);
    if (logo_sprite)     logo_sprite.SetOpacity(0.0);
    bar_track_sprite.SetOpacity(0.0);
    if (bar_fill_sprite) bar_fill_sprite.SetOpacity(0.0);
    if (pct_sprite)      pct_sprite.SetOpacity(0.0);
    if (hint_sprite)     hint_sprite.SetOpacity(0.0);
}

/* ── Boot callbacks ──────────────────────────────────────────── */

/*
 * Plymouth.SetBootProgressFunction
 * Called by: plymouth system-update --progress=N  (0–100 integer)
 * `duration` = seconds since boot; `progress` = 0.0–1.0 float
 */
fun BootProgressCb(duration, progress) {
    boot_progress = Math.Int(progress * 100);
    DrawProgress(boot_progress);
}
Plymouth.SetBootProgressFunction(BootProgressCb);

/*
 * Plymouth.SetUpdateStatusFunction
 * Called by: plymouth update --status="NN:description"
 * We parse a numeric prefix if present (e.g. "55:labwc ready"),
 * otherwise ignore and rely on SetBootProgressFunction.
 */
fun UpdateStatusCb(status) {
    colon = String.Find(status, ":");
    if (colon >= 0) {
        n = Math.Int(String.SubString(status, 0, colon));
        if (n >= 0 && n <= 100) {
            boot_progress = n;
            DrawProgress(boot_progress);
        }
    }
}
Plymouth.SetUpdateStatusFunction(UpdateStatusCb);

/*
 * Plymouth.SetRootMountedFunction
 * Filesystems mounted — mark 10% so there is early visual feedback.
 */
fun RootMountedCb() {
    boot_progress = 10;
    DrawProgress(boot_progress);
}
Plymouth.SetRootMountedFunction(RootMountedCb);

/*
 * Plymouth.SetDisplayNormalFunction
 * Called when returning from verbose/password mode back to splash.
 */
fun DisplayNormalCb() {
    verbose_mode = 0;
    ShowSplash();
}
Plymouth.SetDisplayNormalFunction(DisplayNormalCb);

/*
 * Plymouth.SetDisplayPasswordFunction — required stub; not used.
 */
fun DisplayPasswordCb(prompt, stars) { }
Plymouth.SetDisplayPasswordFunction(DisplayPasswordCb);

/*
 * Plymouth.SetQuitFunction
 * Render 100% then fade all elements to zero so labwc appears cleanly.
 */
fun QuitCb() {
    DrawProgress(100);
    /* Opacity fade is cosmetic; Plymouth itself handles the final hand-off. */
    if (bg_sprite)       bg_sprite.SetOpacity(0.0);
    if (logo_sprite)     logo_sprite.SetOpacity(0.0);
    bar_track_sprite.SetOpacity(0.0);
    if (bar_fill_sprite) bar_fill_sprite.SetOpacity(0.0);
    if (pct_sprite)      pct_sprite.SetOpacity(0.0);
    if (hint_sprite)     hint_sprite.SetOpacity(0.0);
}
Plymouth.SetQuitFunction(QuitCb);

/*
 * Ctrl+V verbose toggle.
 * Plymouth intercepts Ctrl+V and passes key "v" to the key handler.
 * Pressing V hides the splash so the TTY journal scrolls behind it;
 * pressing V again calls DisplayNormal to restore the splash.
 */
fun KeyPressedCb(key) {
    if (key == "v" || key == "V") {
        if (verbose_mode) {
            verbose_mode = 0;
            ShowSplash();
        } else {
            verbose_mode = 1;
            HideSplash();
        }
    }
}
Plymouth.SetKeyHandler(KeyPressedCb);

/* ── Initial render at 0% ────────────────────────────────────── */
DrawProgress(0);
