# /etc/systemd/system/vulos-diwan.service
# Diwan — collaborative office suite backend (github.com/vul-os/diwan).
# Listens on port 8445. No raw network capabilities required.
#
# Install path:  /etc/systemd/system/vulos-diwan.service
# Written by:    scripts/install-vulos.sh

[Unit]
Description=Vulos — Diwan collaborative office suite backend
Documentation=https://docs.vulos.org/self-host/bundle
After=network-online.target vulos-fabric.service vulos.service
Wants=network-online.target
Requires=vulos-fabric.service

[Service]
Type=simple
User=vulos
Group=vulos
# NOTE: the real CLI (diwan/main.go) has no "serve" subcommand — it
# takes server flags directly. A leading positional arg like "serve" would
# make flag.Parse() stop before it ever sees -config, so config.yaml would
# silently fall back to defaults. Use the flag directly.
ExecStart=/usr/local/bin/diwan -config /etc/vulos/office.yaml
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s

# Hardening — no raw network capabilities (listens on 8445, no port < 1024)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vulos/office
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target vulos-bundle.target
