# /etc/systemd/system/vulos.service
# Vulos OS backend — API gateway and app fabric.
# Listens on port 8443. No raw network capabilities required.
#
# Install path:  /etc/systemd/system/vulos.service
# Written by:    scripts/install-vulos.sh

[Unit]
Description=Vulos — OS backend API gateway and app fabric
Documentation=https://docs.vulos.org/self-host/bundle
After=network-online.target vulos-fabric.service
Wants=network-online.target
Requires=vulos-fabric.service

[Service]
Type=simple
User=vulos
Group=vulos
ExecStart=/usr/local/bin/vulos serve --config /etc/vulos/vulos.yaml
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s

# Hardening — no raw network capabilities (listens on 8443, no port < 1024)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vulos/vulos
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target vulos-bundle.target
