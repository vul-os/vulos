# /etc/systemd/system/vulos-lilmail.service
# lilmail — self-hosted PIM client: mail + calendar + contacts
# (github.com/vul-os/lilmail).
#
# IMPORTANT — this is NOT an inbound mail server. lilmail is a single-binary
# IMAP/SMTP/CalDAV/CardDAV CLIENT that connects OUTBOUND to the box owner's
# OWN existing mail account (Gmail, Fastmail, a self-hosted Dovecot/Postfix,
# etc.) — it hosts no mail and binds no privileged port. The previous
# "vulos-mail" unit modelled an inbound SMTP server on ports 25/587 with an
# X25519 keypair; that product no longer exists. CAP_NET_BIND_SERVICE is
# correctly dropped below because there is nothing here that needs it.
#
# lilmail reads a literal "config.toml" from its current working directory
# (no --config flag), so WorkingDirectory below must point at the directory
# holding it.
#
# Install path:  /etc/systemd/system/vulos-lilmail.service
# Written by:    scripts/install-vulos.sh

[Unit]
Description=Vulos — lilmail (mail + calendar + contacts client)
Documentation=https://docs.vulos.org/self-host/bundle
After=network-online.target vulos-fabric.service vulos.service
Wants=network-online.target
Requires=vulos-fabric.service

[Service]
Type=simple
User=vulos
Group=vulos
WorkingDirectory=/etc/vulos/lilmail
ExecStart=/usr/local/bin/lilmail
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s

# Hardening — no capabilities: lilmail only makes outbound IMAP/SMTP/CalDAV/
# CardDAV connections (client role), it never binds a privileged port.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vulos/mail /etc/vulos/lilmail
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target vulos-bundle.target
