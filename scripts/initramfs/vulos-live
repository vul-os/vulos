#!/bin/sh
# Vulos — initramfs-tools init-bottom hook
# Location in rootfs: /etc/initramfs-tools/scripts/init-bottom/vulos-live
#
# Executed by initramfs at init-bottom stage (just before pivot_root to real root).
# Mounts the squashfs through a dm-verity device (block-level runtime integrity),
# adds an in-RAM tmpfs writable layer, and combines them with overlayfs so the
# live system appears fully writable.
#
# Boot kernel cmdline must supply:
#   root=LABEL=VULOS-LIVE-DATA  (the ext4 data partition holding image.squashfs)
#   vulos.live                  (activates this hook)
# The standard initramfs will have already mounted the data partition at $rootmnt
# and set $rootmnt to that mount point.
#
# Layout expected on the data partition (LABEL=VULOS-LIVE-DATA):
#   /image.squashfs      — squashfs archive of the full Vulos rootfs
#   /os-core.hashtree    — dm-verity Merkle hash tree (from gen-verity.sh)
#   /os-core.roothash    — single-line hex root hash (from gen-verity.sh)
#
# dm-verity activation (M3 fix):
#   When veritysetup and the companion .hashtree + .roothash files are present,
#   the squashfs is opened as a dm-verity device (/dev/mapper/vulos-root) before
#   the overlayfs lower mount — activating the kernel's block-level Merkle tree
#   verification on every read.
#
#   If veritysetup is absent (non-live-USB CI builds, rescue shells) or the
#   hash/tree files are missing, the script falls back to a direct loop mount
#   with a clear warning. This ensures the live-boot chain never silently breaks
#   on older images that pre-date verity support.
#
#   To include veritysetup in the initramfs, add it to the COPY list in the
#   baremetal-builder.Dockerfile (copy_exec /sbin/veritysetup) and ensure
#   libcryptsetup is pulled in via the cryptsetup-bin package.

PREREQ=""
prereqs() { echo "$PREREQ"; }

case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

. /scripts/functions

VERITY_NAME="vulos-root"
LOWER="/run/vulos/lower"
RW="/run/vulos/rw"          # one tmpfs holds BOTH upper and work — overlayfs
UPPER="/run/vulos/rw/upper" # requires upperdir and workdir on the same mount
WORK="/run/vulos/rw/work"
MERGED="/run/vulos/merged"

# ── BEGIN-TESTABLE ─────────────────────────────────────────────────────────
# scripts/test-vulos-live-cmdline.sh extracts everything between the
# BEGIN-TESTABLE/END-TESTABLE markers and sources it standalone (no
# /scripts/functions, no real mounts) so the cmdline-parsing + path-derivation
# logic below is unit-tested without booting a kernel. Keep this block
# self-contained: no reference to rootmnt, panic, log_*_msg, or anything else
# that only exists inside a real initramfs.

# The initramfs may not ship grep — a failed `grep` here (command-not-found →
# non-zero → `! grep` true) made this hook exit 0 and skip the live overlay
# entirely, dropping the boot to an initramfs shell. Read the cmdline with pure
# shell instead. Matches a bare token ("vulos.live") or a key ("vulos.live=…").
#
# `read` returns NON-ZERO whenever the line it read has no trailing newline —
# which is exactly how /proc/cmdline is normally presented — even though it
# still populates the variable correctly. The previous form here
# ("read ... || _cl=''") treated that non-zero status as "read failed" and
# threw away the value read just moments before, on every single boot. _cl is
# initialised to "" up front instead, and read's exit status is ignored
# (2>/dev/null keeps a genuine open failure, e.g. no /proc, silent and safe:
# _cl simply stays empty). Caught by TestCmdlineHas_NoTrailingNewline in
# scripts/test-vulos-live-cmdline.sh, which reproduces this exact shape with a
# fixture file that has no trailing newline (as would a real /proc/cmdline).
cmdline_has() {
    _cl=""
    read -r _cl < "${VULOS_CMDLINE_FILE:-/proc/cmdline}" 2>/dev/null
    case " $_cl " in
        *" $1 "*|*" $1="*) return 0 ;;
    esac
    return 1
}

# read_cmdline_value KEY — prints the value of KEY=... on the kernel cmdline
# (last match wins, matching how the kernel itself resolves repeated params),
# or nothing + a non-zero exit when KEY is absent. Reads from
# $VULOS_CMDLINE_FILE when set (unit tests only) so this parsing logic is
# testable without booting a kernel; production always reads /proc/cmdline.
# Same no-trailing-newline fix as cmdline_has above — see its comment.
read_cmdline_value() {
    _cl=""
    read -r _cl < "${VULOS_CMDLINE_FILE:-/proc/cmdline}" 2>/dev/null
    _found=1
    for _tok in $_cl; do
        case "$_tok" in
            "$1="*)
                _val="${_tok#"$1"=}"
                _found=0
                ;;
        esac
    done
    [ "$_found" = 0 ] && printf '%s' "$_val"
    return "$_found"
}

# ── Squashfs / verity artifact locations ──────────────────────────────────────
#
# Default: the plain live-USB layout (build.sh --live) — a single
# image.squashfs + sibling os-core.hashtree/os-core.roothash directly on the
# VULOS-LIVE-DATA data partition (root=LABEL=VULOS-LIVE-DATA).
#
# vulos.squashfs=<path> overrides this. Two installer code paths write it:
#   - BMINIT-14 (backend/internal/installer/esp.go writeLiveBootEntry) for a
#     re-flashed live-USB ESP.
#   - NETB-03 (backend/services/installer/netboot_install.go
#     writeSlotABootEntry) for the OSDIST-02 A/B slot squashfs on the local
#     disk after a netboot install (e.g. /var/cache/vulos/slot-a/os-core.squashfs).
# <path> is interpreted the same way as the default: relative to whatever
# partition root= mounted at $rootmnt.
#
# Until this override existed, vulos.squashfs= was written by both installers
# but read by nothing — the ONLY consumer of the token (this hook, gated on
# cmdline_has vulos.live per the dfff94f5 fix) ignored it and always looked
# for /image.squashfs, so a netboot-installed disk could set vulos.live=0
# correctly and still fail to find its own OS at boot.
SQUASHFS_PATH="/image.squashfs"
HASHTREE_PATH="/os-core.hashtree"
ROOTHASH_PATH="/os-core.roothash"
if _sqf="$(read_cmdline_value vulos.squashfs)" && [ -n "$_sqf" ]; then
    SQUASHFS_PATH="$_sqf"
    # Derive sibling hashtree/roothash paths using the same "<base>.squashfs"
    # → "<base>.hashtree"/"<base>.roothash" convention gen-verity.sh's callers
    # already use for the os-core.* artifact family (OS-DISTRIBUTION.md). Only
    # do this when the override actually ends in .squashfs; otherwise leave
    # the (now almost certainly nonexistent) defaults, which correctly makes
    # verity fall back to the unverified-loop-mount branch below rather than
    # guess at a wrong path.
    case "$SQUASHFS_PATH" in
        *.squashfs)
            _base="${SQUASHFS_PATH%.squashfs}"
            HASHTREE_PATH="${_base}.hashtree"
            ROOTHASH_PATH="${_base}.roothash"
            ;;
    esac
fi

# ── OSDIST-FLIP-01: honour the A/B slot the OS actually selected ──────────────
#
# The cmdline above is written ONCE, at install time, pinned to slot-a. An OTA
# stages the new image into the INACTIVE slot and flips "active" in
# boot-state.json; the boot-counter rollback flips it back. Until this block
# existed nothing read that file at boot, so both were inert: a staged update
# never took effect and — worse — a rollback that had already decided the
# current slot was bad still booted it. A safety mechanism that reports success
# while doing nothing is the failure mode this project has been digging out.
#
# So: the cmdline supplies the DEFAULT, and boot-state.json overrides it when it
# names a slot whose image is actually present.
#
# FAIL CLOSED, deliberately, in this order:
#   - no state file, unreadable, or no "active" key  → keep the cmdline path
#   - "active" is anything but a or b                → keep the cmdline path
#   - the chosen slot's squashfs is missing          → keep the cmdline path
# Never boot nothing because a JSON file was truncated mid-write. The worst case
# here is booting the slot the cmdline named, which is exactly today's
# behaviour.
#
# Parsed with sed rather than jq: the initramfs has no jq, and this must not
# acquire a dependency that a minimal initrd might omit. The pattern matches
# "active"<spaces>:<spaces>"<slot>" and tolerates the whole document being on
# one line, which is how Go's encoding/json writes it without indentation.
read_active_slot() {
    _state="$1"
    [ -r "$_state" ] || return 1

    # PURE SHELL — no sed, no head, no tr, no awk.
    #
    # This first used `sed ... | head -n 1`, and every real boot died with
    # "head: not found": the initramfs does not ship it. Replacing head with
    # GNU sed's `{p;q;}` then broke the unit tests, because macOS ships BSD sed
    # which rejects that syntax. Both failures are the same mistake — depending
    # on a tool being present and behaving the same everywhere — and an
    # initramfs is the worst place to make it. Parameter expansion is in the
    # shell itself, so it cannot be missing.
    #
    # `|| [ -n "$_line" ]` keeps the last line when the file has no trailing
    # newline, which is exactly how Go writes this one. Without it, a
    # single-line boot-state.json is read and then discarded — the same
    # discarding-what-read-just-populated bug already fixed in cmdline_has.
    _slot=""
    while IFS= read -r _line || [ -n "$_line" ]; do
        case "$_line" in
            *'"active"'*)
                _t="${_line#*\"active\"}"
                _t="${_t#*:}"
                # strip leading spaces/tabs before the opening quote
                while :; do
                    case "$_t" in
                        " "*) _t="${_t# }" ;;
                        "	"*) _t="${_t#	}" ;;
                        *) break ;;
                    esac
                done
                _t="${_t#\"}"
                # The value must be CLOSED. Without this, a document truncated
                # mid-write — `{"active":"b` — yields "b" and the machine acts
                # on a half-written file. %%"* silently returns the whole
                # remainder when there is no closing quote, so the absence has
                # to be checked, not inferred.
                case "$_t" in
                    *\"*) _slot="${_t%%\"*}" ;;
                    *) _slot="" ;;
                esac
                break
                ;;
        esac
    done < "$_state"

    case "$_slot" in
        a|b) printf '%s' "$_slot"; return 0 ;;
    esac
    return 1
}


# slot_squashfs_path echoes the squashfs path for a slot, matching the layout
# writeSlotABootEntry pins on the cmdline.
slot_squashfs_path() {
    printf '/var/cache/vulos/slot-%s/os-core.squashfs' "$1"
}

# apply_active_slot rewrites SQUASHFS_PATH (and its verity siblings) to the slot
# boot-state.json names, when that slot's image exists under $2 (the mounted
# root; empty in tests). Returns 0 and sets SELECTED_SLOT when it overrode the
# cmdline, non-zero (leaving everything untouched) when it did not.
#
# The selected slot comes back in a VARIABLE, not on stdout, and the caller must
# invoke this plainly — never as `$(apply_active_slot ...)`. Command
# substitution runs the function in a SUBSHELL, so the SQUASHFS_PATH assignment
# below would be discarded the moment it returned and the override would do
# nothing at all. That is exactly how the first version of this was written, and
# the unit tests below caught it: a slot flip that silently changed nothing is
# the same failure mode this whole change exists to remove.
SELECTED_SLOT=""
apply_active_slot() {
    _statefile="$1"
    _rootpfx="$2"
    SELECTED_SLOT=""
    _slot="$(read_active_slot "$_statefile")" || return 1
    _cand="$(slot_squashfs_path "$_slot")"
    [ -f "${_rootpfx}${_cand}" ] || return 1
    SQUASHFS_PATH="$_cand"
    _base="${SQUASHFS_PATH%.squashfs}"
    HASHTREE_PATH="${_base}.hashtree"
    ROOTHASH_PATH="${_base}.roothash"
    SELECTED_SLOT="$_slot"
    return 0
}

# rootmnt_device MOUNTPOINT — prints the device currently mounted at
# MOUNTPOINT, or nothing + non-zero when it is not mounted. Reads
# $VULOS_MOUNTS_FILE when set (unit tests only); production reads /proc/mounts.
#
# This exists because of what the initramfs `mount` actually IS. It is not
# util-linux's and not busybox's — it is KLIBC's, and klibc mount requires BOTH
# a device and a directory, always:
#
#   Usage: mount [-r] [-w] [-o options] [-t type] [-f] [-i] [-n] device directory
#
# `mount -o remount,rw /root` — the util-linux spelling, where libmount looks
# the device up itself — is therefore a USAGE ERROR here, not a remount. It
# exits 1 having done nothing, and the write that followed it then failed
# against a still-read-only filesystem. Every step was best-effort with stderr
# discarded, so the only symptom was a marker that never appeared. Confirmed by
# instrumenting the hook and booting it: rc=1 with klibc's usage string, then
# "cannot create /root/var/cache/vulos/booted-slot: Read-only file system".
#
# LAST match wins: a later mount at the same point shadows an earlier one, which
# is what a reader of the path would actually get.
#
# Note the mountpoint field in /proc/mounts is octal-escaped (a space is \040).
# Nothing in this boot path mounts under a path needing it, and inventing an
# unescaper for a case that cannot arise would be more risk than it removes — so
# the comparison is literal, and a mountpoint containing a space simply reports
# "not found" and the caller falls back. Documented rather than silently assumed.
rootmnt_device() {
    _rd_dev=""
    while read -r _rd_d _rd_m _rd_rest || [ -n "$_rd_d" ]; do
        [ "$_rd_m" = "$1" ] && _rd_dev="$_rd_d"
    done < "${VULOS_MOUNTS_FILE:-/proc/mounts}"
    [ -n "$_rd_dev" ] || return 1
    printf '%s' "$_rd_dev"
}

# record_booted_slot ROOTMNT SLOT VIA IMAGE — record WHICH SLOT THIS BOOT
# ACTUALLY USED, on disk, where it outlives the boot.
#
# Not a test affordance. An operator asking "did my update actually take?" had
# no way to answer it: the decision was visible only on the console, and the
# installed boot entry carries `quiet splash`, so plymouth swallows it — every
# real boot logs zero vulos-live lines to the serial. A durable marker is the
# only honest answer, and it is what lets the QEMU harness assert the flip
# instead of guessing.
#
# Best-effort by design: a read-only or full root must never stop the machine
# booting over a diagnostic file. Called after the slot is chosen and before the
# switch-root, so it always describes the boot in progress.
#
# The kernel cmdline says `ro`, so $rootmnt is mounted read-only here and a
# plain write fails. The remount MUST name the DEVICE as well as the directory —
# the initramfs `mount` is klibc's and requires both (see rootmnt_device above).
# The device-less util-linux spelling this used before was a usage error that
# remounted nothing, and that is the entire reason the marker never appeared.
#
# This lives inside the testable block so the arity requirement is pinned by
# scripts/test-vulos-live-cmdline.sh against a klibc-faithful fake `mount`,
# rather than only by a QEMU boot. The bug it encodes cost more to find than
# every other part of this hook combined, precisely because nothing but a real
# boot could observe it.
#
# VERITY is recorded here for the same reason the slot is. "Is dm-verity
# actually running on this machine?" was answerable only by reading a serial
# console that `quiet splash` blanks, which is exactly how the fleet ran for
# months with verity inactive while the architecture doc said otherwise. A line
# in this file survives the boot, so an operator — and the QEMU harness's
# Phase 5 — can read the answer instead of inferring it.
#
# SIG is recorded for a reason distinct from VERITY's, and the distinction is
# the whole point of VERITY-04: `verity=active` says the kernel is checking every
# block against a root hash. It says NOTHING about where that root hash came
# from, and a substituted image+roothash pair produces `verity=active` on a
# machine running an attacker's OS. `sig=verified` is the field that separates
# "checking against a number" from "checking against a number the release key
# signed". Reading the first without the second is how this looked solved while
# it was not.
#
#   sig=verified — the release key signed this exact root hash and image size
#   sig=unsigned — a roothash with no verifiable signature beside it (the shape
#                  of every disk installed before VERITY-04; tolerated on a
#                  local disk, refused on netboot)
#   sig=none     — no roothash at all, so there was nothing to authenticate
#
# There is deliberately no "sig=failed": that path panics and the machine does
# not boot, so nothing is left to write it.
record_booted_slot() {
    _rb_root="$1"; _rb_slot="$2"; _rb_via="$3"; _rb_image="$4"; _rb_verity="$5"
    _rb_sig="${6:-none}"
    [ -d "${_rb_root}/var/cache/vulos" ] || return 1

    _rb_remounted=0
    _rb_dev="$(rootmnt_device "$_rb_root")" || _rb_dev=""
    if [ -n "$_rb_dev" ] && mount -o remount,rw "$_rb_dev" "$_rb_root" 2>/dev/null; then
        _rb_remounted=1
    fi
    {
        printf 'slot=%s\nvia=%s\nimage=%s\nverity=%s\nsig=%s\n' \
            "$_rb_slot" "$_rb_via" "$_rb_image" "$_rb_verity" "$_rb_sig" \
            > "${_rb_root}/var/cache/vulos/booted-slot"
        sync
    } 2>/dev/null || true
    [ "$_rb_remounted" = "1" ] && mount -o remount,ro "$_rb_dev" "$_rb_root" 2>/dev/null || true
    return 0
}

# ── END-TESTABLE ───────────────────────────────────────────────────────────

# Only activate when live mode is requested via kernel parameter
if ! cmdline_has vulos.live; then
    exit 0
fi

log_begin_msg "Vulos: setting up live overlayfs"

# Ensure helper directories exist
mkdir -p "$LOWER" "$UPPER" "$WORK" "$MERGED"

# ── dm-verity activation ──────────────────────────────────────────────────────
#
# Attempt to open the squashfs through the kernel's dm-verity driver so that
# every block is verified on read at runtime (not just once at download).
#
# Requirements:
#   1. veritysetup binary in the initramfs (from cryptsetup-bin)
#   2. os-core.hashtree alongside image.squashfs on the data partition
#   3. os-core.roothash alongside image.squashfs on the data partition
#
# On success, LOWER_DEV is /dev/mapper/vulos-root (the verity device).
# On failure (missing tool or files), we fall back to a direct loop mount and
# print a prominent warning so the operator knows verity is not active.

# OSDIST-FLIP-01: the root is mounted by now, so boot-state.json is readable.
# Let it override the install-time cmdline slot (see apply_active_slot above for
# the fail-closed rules). Only meaningful on an installed disk; a live/netboot
# medium has no slot layout and the call simply keeps the cmdline path.
if apply_active_slot "${rootmnt}/var/cache/vulos/boot-state.json" "${rootmnt}"; then
    log_begin_msg "vulos-live: boot-state.json selects slot ${SELECTED_SLOT} — booting ${SQUASHFS_PATH}"
    _booted_slot="$SELECTED_SLOT"
    _booted_via="boot-state"
else
    log_begin_msg "vulos-live: no usable boot-state slot — using the cmdline image ${SQUASHFS_PATH}"
    # Recover the slot from the cmdline path so the record is still meaningful
    # when boot-state was not usable; "?" when the path names no slot at all
    # (a live/netboot medium).
    case "$SQUASHFS_PATH" in
        */slot-a/*) _booted_slot="a" ;;
        */slot-b/*) _booted_slot="b" ;;
        *)          _booted_slot="?" ;;
    esac
    _booted_via="cmdline"
fi

SQUASHFS_ABS="${rootmnt}${SQUASHFS_PATH}"
HASHTREE_ABS="${rootmnt}${HASHTREE_PATH}"
ROOTHASH_ABS="${rootmnt}${ROOTHASH_PATH}"
ROOTHASH_SIG_ABS="${ROOTHASH_ABS}.sig"
# Pinned trust anchor baked into the seed/initramfs (SEED-01).  This is the
# SINGLE gate that authorises the dm-verity root hash — TLS/CA trust is never
# sufficient.  A netboot fetches image.squashfs + os-core.roothash over the
# (possibly plain-HTTP) network, so the roothash MUST be bound to this pinned
# key or an attacker can substitute image+roothash together and defeat verity.
TRUST_ANCHOR_ABS="/etc/vulos/trust-anchor.pub"
# The root-signed certificate that names WHICH release key the anchor authorises.
# Both files are copied into the cpio by the vulos-trust-anchor hook
# (scripts/seed/embed-anchor.sh): "the pre-pivot verifier needs both: the anchor
# to trust, the cert to know which release key that trust extends to".
RELEASE_CERT_ABS="/etc/vulos/release-cert.json"
LOWER_DEV=""

# Netboot marker: when the machine booted over the network the payload is
# attacker-reachable in transit, so verification MUST be fail-closed — the
# unverified loop-mount fallback is forbidden.  A local live-USB (physical
# medium) may still fall back on rescue/CI builds that predate verity.
# The netboot chain (boot.ipxe) sets vulos.netboot=1 on the kernel cmdline.  A
# local live-USB does NOT, so rescue/CI live-USB builds that predate verity keep
# their loop-mount fallback while every network boot is strictly fail-closed.
NETBOOT=0
if cmdline_has vulos.netboot=1; then
    NETBOOT=1
fi

# ── Roothash authenticity gate (VERITY-04) ────────────────────────────────────
#
# dm-verity binds the IMAGE to the root hash.  Nothing in that binds the ROOT
# HASH to anyone.  An attacker who substitutes the squashfs AND os-core.roothash
# together defeats dm-verity completely: the kernel verifies the attacker's
# image against the attacker's hash tree and reports success, and the machine
# comes up clean with `verity=active` recorded.  This gate is what makes the
# root hash a statement by the release key rather than a number found on a disk.
#
# vulos-verify-sig walks the chain the rest of this project agrees on:
#   pinned anchor -> release cert (root sig, expiry, epoch floor) -> release key
#   -> canonical(ImagePayload) -> bound to THESE artifacts by the root hash in
#   the file veritysetup is about to be handed, and the size of the squashfs.
#
# ── POLICY, and why ──────────────────────────────────────────────────────────
#
# A PRESENT-BUT-INVALID signature is FATAL EVERYWHERE.  Forging one is
# infeasible, so this state means substitution or corruption, and both must stop
# the boot.  This is the branch that has never once been reachable: no build
# emitted a .sig and no image carried the verifier, so every boot in this
# project's history took the "not verified" path below.
#
# A MISSING signature is FATAL ON NETBOOT and TOLERATED ON A LOCAL DISK.  That
# asymmetry is deliberate and it is the crux of this change:
#
#   - On netboot the payload is attacker-reachable in transit over (possibly
#     plain) HTTP.  Omitting the .sig would be a free fail-open downgrade for an
#     attacker who controls the wire, so absence must be refused.
#
#   - On an installed disk, refusing would BRICK THE EXISTING FLEET.  Every disk
#     installed before this build has os-core.hashtree and os-core.roothash and
#     NO .sig, because nothing ever produced one.  Phase 4b of
#     scripts/netboot-install-smoke.sh pins the rule that such a disk must still
#     boot, and that rule is not negotiable for a signature that only became
#     producible today.
#
#     The security argument for tolerating it is not merely compatibility.  An
#     attacker who can DELETE the .sig from an installed disk already has write
#     access to that disk — and can equally delete os-core.roothash and
#     os-core.hashtree, which this hook has always tolerated by falling back to a
#     loop mount.  Refusing here would close none of that while breaking every
#     pre-existing machine.  What the signature buys on a local disk is that
#     substituting the image now requires DELETING a signature — a loud,
#     detectable, offline-auditable act — instead of silently swapping two files.
#
# Either way the outcome is RECORDED (sig=verified / sig=unsigned) so an
# operator, and Phase 5, can read which one happened instead of assuming.
ROOTHASH_SIG_STATE="none"
if [ -f "$ROOTHASH_ABS" ]; then
    ROOTHASH_SIG_STATE="unsigned"
    if [ -f "$ROOTHASH_SIG_ABS" ] && [ -f "$TRUST_ANCHOR_ABS" ] \
            && [ -f "$RELEASE_CERT_ABS" ] \
            && command -v vulos-verify-sig >/dev/null 2>&1; then
        log_begin_msg "vulos-live: verifying os-core.roothash signature against pinned anchor..."
        if vulos-verify-sig -anchor "$TRUST_ANCHOR_ABS" -cert "$RELEASE_CERT_ABS" \
                -roothash "$ROOTHASH_ABS" -bundle "$ROOTHASH_SIG_ABS" \
                -image "$SQUASHFS_ABS"; then
            ROOTHASH_SIG_STATE="verified"
            log_end_msg "vulos-live: roothash signature OK (release key, pinned anchor)"
        else
            panic "vulos-live: os-core.roothash signature verification FAILED — the dm-verity root hash is NOT the one the release key signed. The image has been substituted or the artifacts are corrupt. Boot halted (fail closed)."
        fi
    elif [ "$NETBOOT" = "1" ]; then
        panic "vulos-live: netboot requires a signed os-core.roothash. Missing one of: sig=$([ -f "$ROOTHASH_SIG_ABS" ] && echo ok || echo MISSING) anchor=$([ -f "$TRUST_ANCHOR_ABS" ] && echo ok || echo MISSING) cert=$([ -f "$RELEASE_CERT_ABS" ] && echo ok || echo MISSING) verifier=$(command -v vulos-verify-sig >/dev/null 2>&1 && echo ok || echo MISSING). Refusing to boot an unauthenticated image over the network (fail closed)."
    else
        # Itemised, because this is the branch a pre-existing disk takes and an
        # operator needs to see WHICH piece is absent — a missing .sig is the
        # expected legacy shape, while a missing verifier or anchor on a machine
        # that HAS a .sig means the image build regressed.
        log_warning_msg "vulos-live: roothash signature NOT verified — dm-verity still binds the image to this roothash, but nothing binds the roothash to the release key"
        log_warning_msg "vulos-live:   roothash.sig: ${ROOTHASH_SIG_ABS} $([ -f "$ROOTHASH_SIG_ABS" ] && echo 'found' || echo 'MISSING')"
        log_warning_msg "vulos-live:   trust anchor: ${TRUST_ANCHOR_ABS} $([ -f "$TRUST_ANCHOR_ABS" ] && echo 'found' || echo 'MISSING')"
        log_warning_msg "vulos-live:   release cert: ${RELEASE_CERT_ABS} $([ -f "$RELEASE_CERT_ABS" ] && echo 'found' || echo 'MISSING')"
        log_warning_msg "vulos-live:   verifier:     $(command -v vulos-verify-sig 2>/dev/null || echo 'not found')"
    fi
fi

# libdevmapper's udev SYNCHRONISATION must be off in here, or `veritysetup open`
# never returns.
#
# When it creates a device, libdevmapper sets a "udev cookie" (a SysV semaphore)
# and then BLOCKS until udev signals that it has finished processing the event.
# The thing that does the signalling is 95-dm-notify.rules, which ships in the
# dmsetup package — and an initramfs built by initramfs-tools does not contain
# it. udevd is running in here and happily consumes the event; nothing ever
# releases the cookie; veritysetup waits forever.
#
# That is not a theory. With veritysetup and the dm-verity driver present, a real
# QEMU boot got as far as
#
#   Begin: vulos-live: opening dm-verity device (verity-root)...
#   device-mapper: verity: sha256 using shash "sha256-generic"
#
# — the target was created, so the hash tree and root hash were accepted — and
# then the machine sat there with a silent console until it was killed. No panic,
# no error: an indefinite hang, which is the worst possible failure for a boot
# path because it looks like slow hardware.
#
# DM_DISABLE_UDEV=1 tells libdevmapper to create the /dev/mapper node itself and
# not wait for anyone. This is what Debian's own cryptsetup initramfs scripts do,
# and it is correct here for the same reason: the initramfs is not a udev-managed
# system.
export DM_DISABLE_UDEV=1

# dm_available — is the dm-VERITY TARGET reachable from HERE, in the initramfs,
# right now?
#
# `veritysetup open` needs three things, and this hook historically checked only
# two of them (the binary and the hash files). The third is the dm-verity kernel
# driver: on this image dm-mod.ko/dm-verity.ko are MODULES, and the initramfs is
# built with MODULES=most, which does not include drivers/md — verified by
# unpacking a real built initramfs: 1401 modules, none of them device-mapper.
#
# That gap matters because of what this hook does on failure. `veritysetup open`
# failing is a `panic` below, deliberately, since a root-hash mismatch is
# indistinguishable from tampering. Without this check, the day veritysetup
# arrives in the initramfs without its kernel driver, every installed machine
# would panic at boot — a fix for "verity is not running" that bricks the fleet
# instead. "The driver is not here" is a missing PREREQUISITE, exactly like the
# binary being absent, and is handled by the same documented policy: fall back on
# a local disk, refuse to boot on a netboot.
#
# WHY THE CHECK IS THE TARGET AND NOT /dev/mapper/control: this was first written
# as "does the device-mapper control node exist", and a real QEMU boot with
# dm-mod present but dm-verity NOT loadable walked straight past it into the
# panic — the exact brick it was written to prevent:
#
#   dm_verity: Unknown symbol dm_bufio_get (err -2)      ← dm-verity.ko unloadable
#   Begin: vulos-live: opening dm-verity device ...      ← checked the wrong thing
#   Kernel does not support dm-verity mapping.           ← veritysetup's verdict
#   vulos-live: veritysetup open FAILED ... Boot halted.
#   (initramfs)
#
# dm-mod loading proves only that the CORE is there. So: the control node must
# exist (device-mapper usable at all) AND dm-verity must be present as a loaded
# module or built into this kernel. There is no /proc file listing registered dm
# targets — that is an ioctl — so those two are the honest observable signals.
#
# modprobe failures are ignored on purpose: its exit status is not the verdict,
# the evidence it leaves behind is. A kernel with dm-verity built in has no
# module to load and no /sys/module directory, which is why modules.builtin is
# consulted as well; missing that branch would silently disable verity on
# exactly the kernels that support it best.
#
# modules.builtin is scanned with PURE SHELL, not grep. The initramfs does not
# ship grep — its /bin is klibc's (cat, dd, ls, mount, sh, uname, …) and nothing
# else — so a `grep -q` here would fail as command-not-found on every kernel,
# quietly turning the built-in branch into dead code that always answers "no".
# That is the same mistake this file has already paid for twice (`head: not
# found`, and `! grep` making the whole hook exit 0).
dm_available() {
    [ -e /dev/mapper/control ] || modprobe dm_mod >/dev/null 2>&1 || true
    modprobe dm-verity >/dev/null 2>&1 || true

    [ -e /dev/mapper/control ] || return 1
    [ -d /sys/module/dm_verity ] && return 0

    _dm_kv="$(uname -r 2>/dev/null)" || _dm_kv=""
    [ -n "$_dm_kv" ] || return 1
    _dm_bi="/lib/modules/${_dm_kv}/modules.builtin"
    [ -r "$_dm_bi" ] || return 1
    while IFS= read -r _dm_line || [ -n "$_dm_line" ]; do
        case "$_dm_line" in
            *dm-verity.ko*) return 0 ;;
        esac
    done < "$_dm_bi"
    return 1
}

if command -v veritysetup >/dev/null 2>&1 \
        && [ -f "$HASHTREE_ABS" ] \
        && [ -f "$ROOTHASH_ABS" ] \
        && dm_available; then

    ROOTHASH="$(cat "$ROOTHASH_ABS")"
    if [ -z "$ROOTHASH" ]; then
        # An empty roothash cannot verify anything.  On netboot this is fatal;
        # on a local live-USB fall back to loop with a warning.
        if [ "$NETBOOT" = "1" ]; then
            panic "vulos-live: os-core.roothash is empty on a netboot — refusing to boot unverified image (fail closed)."
        fi
        log_warning_msg "vulos-live: os-core.roothash is empty — falling back to loop mount (verity inactive)"
    else
        log_begin_msg "vulos-live: opening dm-verity device (verity-root)..."
        if veritysetup open "$SQUASHFS_ABS" "$VERITY_NAME" "$HASHTREE_ABS" "$ROOTHASH"; then
            LOWER_DEV="/dev/mapper/${VERITY_NAME}"
            log_end_msg "vulos-live: dm-verity device active → $LOWER_DEV"
        else
            # veritysetup open failed. This is a security-relevant failure —
            # panic rather than silently boot an unverified image.
            #
            # NOTE, measured rather than assumed: a WRONG ROOT HASH DOES NOT FAIL
            # HERE. dm-verity is lazy — `veritysetup open` only creates the
            # mapping; the kernel does not read a single data block, let alone
            # check one, until something mounts the device. A boot with a
            # deliberately corrupted os-core.roothash got past this branch with
            # exit 0 and was caught one step later by the squashfs mount (see the
            # panic below, which is the one that actually fires for tampering).
            # What reaches this branch is the structural failures: the dm-verity
            # target unavailable, a hash tree that is not a hash tree, bad
            # geometry. Both paths halt the boot, which is what matters — but the
            # message has to be honest about which one an operator is reading.
            panic "vulos-live: veritysetup open FAILED — dm-verity target unusable (unreadable/ill-formed hash tree, or the kernel driver is absent). Boot halted."
        fi
    fi
else
    # Missing tool or companion files.  On a netboot this is FATAL — an attacker
    # who controls the payload could simply omit veritysetup's inputs to force
    # the unverified loop-mount path (fail-open downgrade).  Refuse it.
    if [ "$NETBOOT" = "1" ]; then
        panic "vulos-live: netboot with dm-verity inputs missing (veritysetup/hashtree/roothash/device-mapper) — refusing the unverified loop-mount fallback (fail closed). veritysetup=$(command -v veritysetup 2>/dev/null || echo none) hashtree=$([ -f "$HASHTREE_ABS" ] && echo ok || echo MISSING) roothash=$([ -f "$ROOTHASH_ABS" ] && echo ok || echo MISSING) device-mapper=$(dm_available && echo ok || echo MISSING)"
    fi
    # Local live-USB / rescue / pre-verity CI build: warn clearly but continue.
    # Every prerequisite is itemised, because the ONLY way this state was ever
    # diagnosed was by reading these four lines off a real serial console.
    log_warning_msg "vulos-live: a dm-verity prerequisite is missing — mounting squashfs without dm-verity (block-level verification inactive)"
    log_warning_msg "vulos-live:   veritysetup: $(command -v veritysetup 2>/dev/null || echo 'not found')"
    log_warning_msg "vulos-live:   hashtree:    ${HASHTREE_ABS} $([ -f "$HASHTREE_ABS" ] && echo 'found' || echo 'MISSING')"
    log_warning_msg "vulos-live:   roothash:    ${ROOTHASH_ABS} $([ -f "$ROOTHASH_ABS" ] && echo 'found' || echo 'MISSING')"
    log_warning_msg "vulos-live:   device-mapper: $(dm_available && echo '/dev/mapper/control present' || echo 'MISSING (dm-mod/dm-verity not in this initramfs)')"
fi

# Record which slot this boot used AND whether dm-verity is actually running
# (see record_booted_slot above for why this marker exists and why the remount
# must name the device).
#
# Written HERE, after the verity decision and before the lower layer is mounted:
# any earlier and it could not report verity at all, any later and a failed
# overlay would lose the record of a boot that did happen. If verity was
# supposed to open and could not, the hook has already panicked and nothing is
# written — which is correct, because that machine did not boot.
#
# One limit on how far `verity=active` can be read, since it is what
# scripts/netboot-install-smoke.sh Phase 5 asserts on: it means THE VERITY DEVICE
# WAS OPENED, not that the OS came up through it. A disk with a wrong root hash
# gets `verity=active` written here and then halts at the mount below, because
# dm-verity checks nothing until a block is read. The marker is only evidence of
# a verified boot when read together with the machine actually being up — which
# is why Phase 5 requires the HTTP boot of Phase 3/4 to have passed first, and
# does not treat this line as sufficient on its own.
record_booted_slot "$rootmnt" "$_booted_slot" "$_booted_via" "$SQUASHFS_PATH" \
    "$([ -n "$LOWER_DEV" ] && echo active || echo inactive)" \
    "$ROOTHASH_SIG_STATE" || true

# ── Mount lower layer (dm-verity device or plain loop) ───────────────────────
if [ -n "$LOWER_DEV" ]; then
    # Mount the dm-verity block device read-only as the overlayfs lower layer.
    # The kernel verifies every 4096-byte block against the Merkle tree on read.
    #
    # THIS is where a root-hash mismatch actually lands, not the `veritysetup
    # open` branch above — see the note there. Because dm-verity checks nothing
    # until a block is read, the FIRST read is the mount, and a wrong root hash
    # surfaces as this mount failing with the kernel printing
    #
    #   device-mapper: verity: 7:1: metadata block 1 is corrupted
    #
    # just above it. Verified by booting a disk whose os-core.roothash had been
    # replaced with a valid-shaped but wrong 64-hex value: the machine halted
    # here, at "(initramfs)", and never served HTTP. So the failure is fail-closed
    # as designed — but the previous message ("failed to mount ... as squashfs")
    # reads like a filesystem problem, when the overwhelmingly likely cause is
    # that the image does not match the root hash it is pinned to. Say that.
    if ! mount -t squashfs -o ro "$LOWER_DEV" "$LOWER"; then
        panic "vulos-live: dm-verity VERIFICATION FAILED — $SQUASHFS_ABS does not match the root hash in $ROOTHASH_PATH (the kernel rejects blocks as they are read; look for 'device-mapper: verity: ... is corrupted' above). The image is damaged or has been tampered with. Boot halted."
    fi
else
    # Fallback: direct loop mount (no block-level verity). The initramfs `mount`
    # does not auto-attach a loop device — it forwards `-o loop` to the squashfs
    # driver, which rejects it ("Unknown parameter 'loop'") — so attach the loop
    # device explicitly with losetup, then fall back to a plain mount for kernels
    # whose mount does auto-loop.
    _sq_loop="$(losetup -f 2>/dev/null)"
    if [ -n "$_sq_loop" ] && losetup "$_sq_loop" "$SQUASHFS_ABS" 2>/dev/null \
            && mount -t squashfs -o ro "$_sq_loop" "$LOWER" 2>/dev/null; then
        :
    elif mount -t squashfs -o ro "$SQUASHFS_ABS" "$LOWER" 2>/dev/null; then
        :
    else
        panic "vulos-live: failed to mount squashfs at $SQUASHFS_ABS (losetup=$(command -v losetup 2>/dev/null || echo none), loop free=$_sq_loop)"
    fi
fi

# Writable tmpfs layer (in RAM) holding BOTH upperdir and workdir. overlayfs
# requires them on the same mount, so mount one tmpfs at $RW and create both
# inside it (previously the tmpfs was mounted AT upper, leaving work on a
# different mount → "workdir and upperdir must reside under the same mount").
mkdir -p "$RW"
if ! mount -t tmpfs -o mode=0755 tmpfs-rw "$RW"; then
    panic "vulos-live: failed to mount tmpfs rw layer"
fi
mkdir -p "$UPPER" "$WORK"

# Overlay: lower=squashfs/verity(ro), upper=tmpfs(rw)
if ! mount -t overlay -o "lowerdir=$LOWER,upperdir=$UPPER,workdir=$WORK" overlay "$MERGED"; then
    panic "vulos-live: failed to mount overlayfs"
fi

# Move the merged overlay to $rootmnt so the standard pivot_root works.
#
# There used to be two lines here, before the rebind below:
#
#   mkdir -p "${rootmnt}/run/vulos"
#   mount -o bind /run/vulos "${rootmnt}/run/vulos"
#
# with the comment "bind-mount /run/vulos into the new root so our sub-mounts
# remain visible". They could not do that, and never did. They are the third and
# fourth lines of EVERY boot this project has ever produced:
#
#   mkdir: /root/run: Read-only file system
#   mount: No such file or directory
#
# — visible even under `quiet splash`, because those are the raw stderr of
# klibc's mkdir and mount, while initramfs-tools' log_*_msg helpers return
# immediately when quiet=y. Four years of boot logs opening with errors is how a
# log stops being read.
#
# WHY THEY COULD NOT WORK. At this point $rootmnt is still the DATA PARTITION —
# the ext4 that root=LABEL=VULOS-LIVE-DATA named, mounted `ro` per the cmdline,
# holding image.squashfs and nothing resembling a root filesystem. It has no
# /run, and it cannot be given one: it is read-only. So the mkdir failed, and
# the bind then failed for want of its target.
#
# Reordering would not have saved them either. Put after the rebind below,
# $rootmnt is the writable overlay and both commands succeed — and the result is
# still discarded, because initramfs-tools' own /init does this a few lines after
# it runs us (init:281, read out of this image's initrd, not assumed):
#
#   mount -n -o move /run ${rootmnt}/run
#
# MS_MOVE takes the whole subtree, so /run/vulos/lower, /run/vulos/rw and
# /run/vulos/merged travel to the real root with it, and anything we had bound
# under ${rootmnt}/run would be shadowed by that move regardless. The stated goal
# is already met by the stock boot path.
#
# That /run really is the initramfs's own tmpfs, moved rather than recreated, was
# measured rather than reasoned: the multi-screen kiosk failed with EACCES
# exec'ing /run/vulos-kiosk/session.sh on a real boot, because the mount carries
# the initramfs's noexec flag for the life of the system (roadmap/SCREENS-QEMU.md).
#
# So the two lines are deleted, not moved. Pinned by
# TestLiveHookNeverWritesIntoTheReadOnlyDataPartition in
# backend/internal/docsref/livehook_test.go, which runs THIS file against a
# fabricated read-only $rootmnt with klibc-shaped mount/mkdir stubs and fails on
# any write to $rootmnt before the rebind below.

# Rebind $rootmnt to the merged overlay view.
#
# This is the one write to $rootmnt that belongs here, and it is a mount ONTO
# the directory, not a write INTO the filesystem — which is why it works on a
# read-only ext4 while the mkdir above did not.
mount -o bind "$MERGED" "$rootmnt"

if [ -n "$LOWER_DEV" ]; then
    log_end_msg "Vulos: live overlayfs active (dm-verity ro + tmpfs rw)"
else
    log_end_msg "Vulos: live overlayfs active (squashfs loop ro + tmpfs rw — verity inactive)"
fi

exit 0
